{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "types": [],
    "target": "ES2020"
  },
  "files": ["src/main.ts", "src/app/remote-entry/entry.routes.ts"],
